# SANDBOX ONLY. Save as .env (do not commit the real file).
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Only for an authorized platform with a configured connected account.
AIRWALLEX_CONNECTED_ACCOUNT_ID=
# Optional if you already have a temporary bearer token (expires frequently).
AIRWALLEX_ACCESS_TOKEN=
# Optional - configure only if using real, signed webhooks from Airwallex.
AIRWALLEX_WEBHOOK_SECRET_LEGACY=
AIRWALLEX_WEBHOOK_SECRET_TARGET=
